[Unit]
Description=Create a %i encrypted pgBackRest backup in both hot repositories
Requires=mail-postgres.service mail-pgbackrest-init.service
After=mail-postgres.service mail-pgbackrest-init.service network-online.target

[Service]
Type=oneshot
ExecStart={{ quadlet_directory }}/mail-backup-run.sh %i
StateDirectory=mail-backup
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=full
TimeoutStartSec=43320
