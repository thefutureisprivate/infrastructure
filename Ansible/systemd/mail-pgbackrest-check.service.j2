[Unit]
Description=Verify both encrypted pgBackRest repositories and WAL archiving
Requires=mail-postgres.service mail-pgbackrest-init.service
After=mail-postgres.service mail-pgbackrest-init.service network-online.target

[Service]
Type=oneshot
ExecStart={{ quadlet_directory }}/mail-backup-run.sh check
StateDirectory=mail-backup
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=full
TimeoutStartSec=23520
