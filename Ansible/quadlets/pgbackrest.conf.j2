[stalwart]
pg1-path=/var/lib/postgresql/18/docker
pg1-socket-path=/run/postgresql
pg1-port=5432
pg1-database=stalwart
pg1-user=postgres

[global]
repo1-type=s3
repo1-path=/stalwart/pgbackrest
repo1-s3-bucket={{ mail_backup_hetzner_bucket }}
repo1-s3-endpoint={{ mail_backup_hetzner_endpoint }}
repo1-s3-region={{ mail_backup_hetzner_region }}
repo1-s3-uri-style=path
repo1-s3-key-type=shared
repo1-storage-verify-tls=y
repo1-cipher-type=aes-256-cbc
repo1-bundle=y
repo1-block=y
repo1-retention-full-type=time
repo1-retention-full=35
repo1-retention-diff=7

repo2-type=s3
repo2-path=/stalwart/pgbackrest
repo2-s3-bucket={{ mail_backup_b2_bucket }}
repo2-s3-endpoint={{ mail_backup_b2_endpoint }}
repo2-s3-region={{ mail_backup_b2_region }}
repo2-s3-uri-style=path
repo2-s3-key-type=shared
repo2-storage-verify-tls=y
repo2-cipher-type=aes-256-cbc
repo2-bundle=y
repo2-block=y
repo2-retention-full-type=time
repo2-retention-full=35
repo2-retention-diff=7

# Keep retention changes operator-controlled. The shared Hetzner key is mutable;
# the generated B2 runtime key cannot delete completed objects.
expire-auto=n
archive-async=y
archive-timeout=300
spool-path=/var/lib/pgbackrest/spool
lock-path=/var/lib/pgbackrest/lock
log-level-console=info
log-level-file=off
compress-type=zst
compress-level=6
process-max=2
start-fast=y
