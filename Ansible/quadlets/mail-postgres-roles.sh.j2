#!/usr/bin/env bash
set -euo pipefail

if [[ ${1:-} != inside ]]; then
  if (($# != 0)); then
    printf 'Usage: %s\n' "$0" >&2
    exit 2
  fi
  exec /usr/bin/podman exec --user 70 mail-postgres \
    /usr/local/sbin/mail-postgres-roles inside
fi
if (($# != 1)); then
  printf 'The internal role reconciler accepts no additional arguments.\n' >&2
  exit 2
fi

# Database- and role-level settings are controlled by less-trusted application
# state. Force the safe path in the startup packet, before the first query.
export PGOPTIONS='-c search_path=pg_catalog'
psql=(psql --quiet --no-password --no-psqlrc --set=ON_ERROR_STOP=1 --dbname=stalwart)
bootstrap_role=$(
  "${psql[@]}" --username=postgres --tuples-only --no-align \
    --command='SELECT rolname FROM pg_catalog.pg_roles WHERE oid = 10' 2>/dev/null \
  || "${psql[@]}" --username=stalwart --tuples-only --no-align \
    --command='SELECT rolname FROM pg_catalog.pg_roles WHERE oid = 10' 2>/dev/null \
  || true
)

case "${bootstrap_role}" in
  postgres)
    ;;
  stalwart)
    postgres_exists=$(
      "${psql[@]}" --username=stalwart --tuples-only --no-align \
        --command="SELECT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = 'postgres')"
    )
    if [[ ${postgres_exists} != f ]]; then
      printf 'Cannot safely rename the legacy bootstrap role because postgres already exists.\n' >&2
      exit 1
    fi

    # A PostgreSQL bootstrap superuser cannot lose SUPERUSER. Use a transient
    # local-only superuser to rename that identity, then remove the migrator.
    "${psql[@]}" --username=stalwart <<'SQL'
SELECT 'CREATE ROLE mail_role_migrator WITH LOGIN SUPERUSER'
WHERE NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = 'mail_role_migrator')
\gexec
ALTER ROLE mail_role_migrator WITH LOGIN SUPERUSER;
SQL
    "${psql[@]}" --username=mail_role_migrator <<'SQL'
ALTER ROLE stalwart RENAME TO postgres;
SQL
    ;;
  *)
    printf 'Expected postgres or legacy stalwart as PostgreSQL bootstrap role, found: %s\n' \
      "${bootstrap_role:-missing}" >&2
    exit 1
    ;;
esac

"${psql[@]}" --username=postgres <<'SQL'
BEGIN;

SELECT pg_catalog.format(
  'ALTER ROLE postgres WITH LOGIN SUPERUSER CREATEDB CREATEROLE REPLICATION BYPASSRLS PASSWORD %L',
  pg_catalog.pg_read_file('/run/secrets/postgres-admin-password')
)
\gexec

SELECT pg_catalog.format(
  'CREATE ROLE stalwart WITH LOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS PASSWORD %L',
  pg_catalog.pg_read_file('/run/secrets/postgres-password')
)
WHERE NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = 'stalwart')
\gexec

SELECT pg_catalog.format(
  'CREATE ROLE stalwart_dump WITH LOGIN INHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS PASSWORD %L',
  pg_catalog.pg_read_file('/run/secrets/postgres-dump-password')
)
WHERE NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = 'stalwart_dump')
\gexec

-- Existing installations initialized stalwart as the bootstrap superuser.
-- Transfer only user-schema objects after renaming that identity to postgres;
-- never use REASSIGN OWNED, which would also reach PostgreSQL system objects.
SELECT pg_catalog.format(
  'ALTER %s %I.%I OWNER TO stalwart',
  CASE relation.relkind
    WHEN 'r' THEN 'TABLE'
    WHEN 'p' THEN 'TABLE'
    WHEN 'v' THEN 'VIEW'
    WHEN 'm' THEN 'MATERIALIZED VIEW'
    WHEN 'S' THEN 'SEQUENCE'
    WHEN 'f' THEN 'FOREIGN TABLE'
  END,
  namespace.nspname,
  relation.relname
)
FROM pg_catalog.pg_class AS relation
JOIN pg_catalog.pg_namespace AS namespace ON namespace.oid = relation.relnamespace
WHERE relation.relkind IN ('r', 'p', 'v', 'm', 'S', 'f')
  AND namespace.nspname !~ '^pg_'
  AND namespace.nspname <> 'information_schema'
  AND pg_catalog.pg_get_userbyid(relation.relowner) = 'postgres'
  -- ALTER TABLE transfers linked serial and identity sequences. PostgreSQL
  -- rejects changing those sequence owners independently.
  AND (
    relation.relkind <> 'S'
    OR NOT EXISTS (
      SELECT
      FROM pg_catalog.pg_depend AS ownership_dependency
      WHERE ownership_dependency.classid = 'pg_catalog.pg_class'::pg_catalog.regclass
        AND ownership_dependency.objid = relation.oid
        AND ownership_dependency.refclassid = 'pg_catalog.pg_class'::pg_catalog.regclass
        AND ownership_dependency.deptype IN ('a', 'i')
    )
  )
  AND NOT EXISTS (
    SELECT
    FROM pg_catalog.pg_depend AS dependency
    WHERE dependency.classid = 'pg_catalog.pg_class'::pg_catalog.regclass
      AND dependency.objid = relation.oid
      AND dependency.deptype = 'e'
  )
\gexec

SELECT pg_catalog.format(
  'ALTER %s %I.%I(%s) OWNER TO stalwart',
  CASE routine.prokind
    WHEN 'p' THEN 'PROCEDURE'
    WHEN 'a' THEN 'AGGREGATE'
    ELSE 'FUNCTION'
  END,
  namespace.nspname,
  routine.proname,
  pg_catalog.pg_get_function_identity_arguments(routine.oid)
)
FROM pg_catalog.pg_proc AS routine
JOIN pg_catalog.pg_namespace AS namespace ON namespace.oid = routine.pronamespace
WHERE routine.prokind IN ('f', 'p', 'w', 'a')
  AND namespace.nspname !~ '^pg_'
  AND namespace.nspname <> 'information_schema'
  AND pg_catalog.pg_get_userbyid(routine.proowner) = 'postgres'
  AND NOT EXISTS (
    SELECT
    FROM pg_catalog.pg_depend AS dependency
    WHERE dependency.classid = 'pg_catalog.pg_proc'::pg_catalog.regclass
      AND dependency.objid = routine.oid
      AND dependency.deptype = 'e'
  )
\gexec

SELECT pg_catalog.format(
  'ALTER %s %I.%I OWNER TO stalwart',
  CASE data_type.typtype WHEN 'd' THEN 'DOMAIN' ELSE 'TYPE' END,
  namespace.nspname,
  data_type.typname
)
FROM pg_catalog.pg_type AS data_type
JOIN pg_catalog.pg_namespace AS namespace ON namespace.oid = data_type.typnamespace
-- A multirange is internally owned by its range and rejects ALTER TYPE;
-- changing the range owner transfers the generated multirange as well.
WHERE data_type.typtype IN ('c', 'd', 'e', 'r')
  AND namespace.nspname !~ '^pg_'
  AND namespace.nspname <> 'information_schema'
  AND pg_catalog.pg_get_userbyid(data_type.typowner) = 'postgres'
  AND NOT EXISTS (
    SELECT
    FROM pg_catalog.pg_depend AS dependency
    WHERE dependency.classid = 'pg_catalog.pg_type'::pg_catalog.regclass
      AND dependency.objid = data_type.oid
      AND dependency.deptype = 'e'
  )
\gexec

-- The application may own its objects, but never the database or a schema
-- consulted by privileged maintenance. It receives only migration rights in
-- the one application schema.
ALTER DATABASE stalwart OWNER TO postgres;
REVOKE CREATE ON DATABASE stalwart FROM PUBLIC, stalwart;
ALTER SCHEMA public OWNER TO postgres;
REVOKE CREATE ON SCHEMA public FROM PUBLIC;
GRANT USAGE, CREATE ON SCHEMA public TO stalwart;

-- PostgreSQL grants new routines to PUBLIC by default. Without explicit
-- existing and default ACLs, the read-only dump role could invoke an
-- application-created SECURITY DEFINER routine and write through the routine
-- owner. Remove direct and inherited legacy grants as well as the implicit
-- PUBLIC grant.
REVOKE EXECUTE ON ALL ROUTINES IN SCHEMA public
  FROM PUBLIC, stalwart_dump, pg_read_all_data;
ALTER DEFAULT PRIVILEGES FOR ROLE stalwart IN SCHEMA public
  REVOKE EXECUTE ON ROUTINES FROM PUBLIC, stalwart_dump, pg_read_all_data;

SELECT pg_catalog.format('REVOKE %I FROM %I', granted_role.rolname, member_role.rolname)
FROM pg_catalog.pg_auth_members AS membership
JOIN pg_catalog.pg_roles AS granted_role ON granted_role.oid = membership.roleid
JOIN pg_catalog.pg_roles AS member_role ON member_role.oid = membership.member
WHERE member_role.rolname = 'stalwart'
  OR (
    member_role.rolname = 'stalwart_dump'
    AND granted_role.rolname <> 'pg_read_all_data'
  )
\gexec
GRANT CONNECT ON DATABASE stalwart TO stalwart_dump;
SELECT 'GRANT pg_read_all_data TO stalwart_dump'
WHERE NOT pg_catalog.pg_has_role('stalwart_dump', 'pg_read_all_data', 'member')
\gexec
ALTER ROLE stalwart_dump SET default_transaction_read_only = on;

SELECT pg_catalog.format(
  'ALTER ROLE stalwart_dump WITH LOGIN INHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS PASSWORD %L',
  pg_catalog.pg_read_file('/run/secrets/postgres-dump-password')
)
\gexec
SELECT pg_catalog.format(
  'ALTER ROLE stalwart WITH LOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS PASSWORD %L',
  pg_catalog.pg_read_file('/run/secrets/postgres-password')
)
\gexec

SELECT 'DROP ROLE mail_role_migrator'
WHERE EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = 'mail_role_migrator')
\gexec
COMMIT;
SQL

role_state=$(
  "${psql[@]}" --username=postgres --tuples-only --no-align --field-separator='|' --command="
    SELECT
      (SELECT rolname = 'postgres' AND rolsuper FROM pg_catalog.pg_roles WHERE oid = 10),
      (SELECT rolsuper OR rolcreatedb OR rolcreaterole OR rolreplication OR rolbypassrls
         FROM pg_catalog.pg_roles WHERE rolname = 'stalwart'),
      (SELECT rolsuper OR rolcreatedb OR rolcreaterole OR rolreplication OR rolbypassrls
         FROM pg_catalog.pg_roles WHERE rolname = 'stalwart_dump'),
      pg_catalog.pg_has_role('stalwart_dump', 'pg_read_all_data', 'member'),
      NOT EXISTS (
        SELECT
        FROM pg_catalog.pg_auth_members AS membership
        JOIN pg_catalog.pg_roles AS member_role ON member_role.oid = membership.member
        WHERE member_role.rolname = 'stalwart'
      ),
      NOT EXISTS (
        SELECT
        FROM pg_catalog.pg_auth_members AS membership
        JOIN pg_catalog.pg_roles AS granted_role ON granted_role.oid = membership.roleid
        JOIN pg_catalog.pg_roles AS member_role ON member_role.oid = membership.member
        WHERE member_role.rolname = 'stalwart_dump'
          AND granted_role.rolname <> 'pg_read_all_data'
      ),
      (SELECT pg_catalog.pg_get_userbyid(datdba) = 'postgres'
         FROM pg_catalog.pg_database WHERE datname = 'stalwart'),
      NOT EXISTS (
        SELECT FROM pg_catalog.pg_roles
        WHERE rolsuper AND rolname <> 'postgres'
      ),
      pg_catalog.current_schemas(true) = ARRAY['pg_catalog']::name[];
  "
)
if [[ ${role_state} != 't|f|f|t|t|t|t|t|t' ]]; then
  printf 'PostgreSQL role reconciliation produced an unsafe state: %s\n' "${role_state}" >&2
  exit 1
fi
