project_name = "stalwart-mail"
name_prefix  = "mail"

# A native image exists only long enough to boot the final server into Rescue;
# coreos-installer then overwrites its disk with verified Fedora CoreOS.
bootstrap_image = "fedora-44"

# This deployment uses a single x86 CX23 for Stalwart and PostgreSQL.
default_server_type = "cx23"
default_location    = "nbg1"

nodes = {
  "01" = {}
}
mail_server_node_key = "01"

# Existing deployments can adopt their current Hetzner Primary IP IDs here.
# New deployments leave this empty; OpenTofu creates protected addresses first
# and attaches them to the server.
primary_ip_import_ids = {}

# Stalwart services: federated SMTP, HTTPS/JMAP/admin, implicit-TLS SMTP
# submission, and IMAPS. The temporary port 8080 bootstrap UI stays bound to
# host loopback and is never admitted by the Hetzner firewall.
mail_ingress_rules = [
  {
    description = "SMTP"
    protocol    = "tcp"
    port        = "25"
    source_ips  = ["0.0.0.0/0", "::/0"]
  },
  {
    description = "HTTPS and JMAP"
    protocol    = "tcp"
    port        = "443"
    source_ips  = ["0.0.0.0/0", "::/0"]
  },
  {
    description = "SMTP submission over implicit TLS"
    protocol    = "tcp"
    port        = "465"
    source_ips  = ["0.0.0.0/0", "::/0"]
  },
  {
    description = "IMAP over implicit TLS"
    protocol    = "tcp"
    port        = "993"
    source_ips  = ["0.0.0.0/0", "::/0"]
  }
]

enable_backups           = true
enable_delete_protection = true

# deSEC is mandatory. The zone must already exist. The SOPS-injected
# DESEC_API_TOKEN must read it, manage declared records, and mint child tokens.
desec_domain = "example.com"
desec_ttl    = 3600

# Initial rollout starts empty. `make stalwart-bootstrap` discovers the exact
# selectors, writes an ignored generated override, applies only those token
# policies, and then enables automatic publication. Do not populate this base
# file; normal plans include the generated override when it exists.
stalwart_dkim_selectors = []

# The mail node must use a non-apex hostname so reverse DNS can match it.
desec_node_subnames = {
  "01" = "mail"
}
